# =============================================================================
# PRISM - Docker Ignore File
# =============================================================================

# Git
.git/
.gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
*.egg
venv/
.venv/
ENV/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Testing
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
test/

# Documentation (not needed in production)
docs/
*.md
!README.md

# Data files (should use volumes)
cache/
log/
*.db
*.db-journal
spiderfoot.db*
spiderfoot.test.db
*.log

# Docker
Dockerfile
Dockerfile.*
!Dockerfile.render
docker-compose*.yml
.dockerignore

# Sandbox (Docker-in-Docker — not supported on Render)
sandbox/
sandbox_out/

# Misc
*.pdf
*.csv
*.xlsx
*.png
*.jpg
*.jpeg
*.gif
